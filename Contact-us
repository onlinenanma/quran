<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Contact Quran Meaning (https://quranmeaning.app) — send feedback, report translation or audio issues, or reach out via email." />
  <title>Contact Us — Quran Meaning</title>
  <style>
    :root {
      --bg: #f7f9f8;
      --surface: #ffffff;
      --surface-alt: #eef4f1;
      --text: #16231d;
      --muted: #4b6157;
      --primary: #14533a;
      --primary-hover: #0e3d2a;
      --accent: #b5892e;
      --border: #d7e2dc;
      --shadow: 0 8px 24px rgba(20, 83, 58, 0.06);
      --radius: 14px;
      --max-w: 880px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.65;
    }

    a {
      color: var(--primary);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .topbar-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0.85rem 1.25rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--primary);
    }

    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-links a {
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text);
    }

    .nav-links a:hover {
      background: var(--surface-alt);
      text-decoration: none;
    }

    .nav-links a.active {
      background: var(--primary);
      color: #ffffff;
    }

    main {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 2rem 1.25rem 3.5rem;
    }

    .hero {
      background: linear-gradient(135deg, #14533a 0%, #1d6b4c 100%);
      color: #ffffff;
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      margin-bottom: 1.75rem;
    }

    .hero .eyebrow {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.14);
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
    }

    .hero h1 {
      margin: 0 0 0.5rem;
      font-size: clamp(1.65rem, 3.2vw, 2.25rem);
      line-height: 1.2;
    }

    .hero p {
      margin: 0;
      color: rgba(255, 255, 255, 0.92);
      font-size: 0.98rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 1.35rem;
      align-items: start;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.65rem;
      box-shadow: var(--shadow);
      margin-bottom: 1.35rem;
    }

    .card h2 {
      margin: 0 0 0.75rem;
      font-size: 1.2rem;
      color: var(--primary);
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--border);
    }

    .field {
      margin-bottom: 1rem;
    }

    label {
      display: block;
      font-weight: 600;
      font-size: 0.92rem;
      margin-bottom: 0.35rem;
      color: var(--text);
    }

    input, select, textarea {
      width: 100%;
      padding: 0.7rem 0.85rem;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--text);
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 10px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(20, 83, 58, 0.12);
    }

    textarea {
      min-height: 135px;
      resize: vertical;
    }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
      margin-top: 0.5rem;
    }

    button {
      cursor: pointer;
      font-family: inherit;
      font-size: 0.94rem;
      font-weight: 600;
      border-radius: 10px;
      padding: 0.72rem 1.2rem;
      border: 1px solid transparent;
      transition: background 0.15s ease, transform 0.05s ease;
    }

    button:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: var(--surface-alt);
      color: var(--primary);
      border-color: var(--border);
    }

    .btn-secondary:hover {
      background: #e1ece6;
    }

    .hint {
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 0.75rem;
    }

    .status-box {
      margin-top: 0.9rem;
      padding: 0.8rem 1rem;
      border-radius: 10px;
      font-size: 0.9rem;
      display: none;
    }

    .status-box.show {
      display: block;
    }

    .status-box.info {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      color: var(--primary);
    }

    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .info-list li {
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.93rem;
    }

    .info-list li:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin-bottom: 0.15rem;
    }

    .email-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: var(--surface-alt);
      border: 1px solid var(--border);
      padding: 0.4rem 0.7rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      margin-top: 0.25rem;
    }

    footer {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 1.5rem 1.25rem 2.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.9rem;
      color: var(--muted);
    }

    @media (max-width: 780px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .hero, .card {
        padding: 1.25rem;
      }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="https://quranmeaning.app">
        <span class="brand-dot" aria-hidden="true"></span>
        <span>Quran Meaning</span>
      </a>
      <nav class="nav-links" aria-label="Page navigation">
        <a href="https://quranmeaning.app">Home</a>
        <a href="privacy-policy.html">Privacy Policy</a>
        <a class="active" href="contact-us.html">Contact Us</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <span class="eyebrow">Get in Touch</span>
      <h1>Contact Us</h1>
      <p>Have feedback on <strong>Quran Meaning</strong> (<code>https://quranmeaning.app</code>), spotted an issue with text, translation, or audio, or have a privacy question? Send a note below.</p>
    </section>

    <div class="grid">
      <section class="card" aria-labelledby="form-heading">
        <h2 id="form-heading">Send a Message</h2>
        <form id="contactForm" action="mailto:appnanma@gmail.com" method="post" enctype="text/plain">
          <div class="field">
            <label for="name">Your Name</label>
            <input id="name" name="Name" type="text" placeholder="e.g., Omar" required />
          </div>

          <div class="field">
            <label for="email">Your Email</label>
            <input id="email" name="Email" type="email" placeholder="you@example.com" required />
          </div>

          <div class="field">
            <label for="topic">Topic</label>
            <select id="topic" name="Topic">
              <option value="General Feedback">General Feedback</option>
              <option value="Content or Translation Note">Content or Translation Note</option>
              <option value="Audio or TTS Issue">Audio or TTS Issue</option>
              <option value="App or Website Bug">App or Website Bug</option>
              <option value="Privacy Question">Privacy Question</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="Message" placeholder="Share details, page link, or device/browser info if reporting an issue..." required></textarea>
          </div>

          <div class="btn-row">
            <button type="submit" class="btn-primary">Compose Email</button>
            <button type="button" id="copySummaryBtn" class="btn-secondary">Copy Message Text</button>
          </div>

          <div id="statusBox" class="status-box info" role="status" aria-live="polite"></div>

          <p class="hint">
            By default, this form opens your mail app addressed to <strong>appnanma@gmail.com</strong>. If you use a static form endpoint (such as Web3Forms), set the form's <code>action</code> attribute to your endpoint URL and include your access key.
          </p>
        </form>
      </section>

      <aside>
        <div class="card">
          <h2>Direct Contact</h2>
          <ul class="info-list">
            <li>
              <span class="info-label">Website</span>
              <a href="https://quranmeaning.app">https://quranmeaning.app</a>
            </li>
            <li>
              <span class="info-label">Email</span>
              <div class="email-pill">
                <a href="mailto:appnanma@gmail.com">appnanma@gmail.com</a>
              </div>
              <div class="btn-row" style="margin-top: 0.55rem;">
                <button type="button" id="copyEmailBtn" class="btn-secondary" style="padding: 0.45rem 0.8rem; font-size: 0.85rem;">Copy Email Address</button>
              </div>
            </li>
            <li>
              <span class="info-label">Privacy</span>
              Read our <a href="privacy-policy.html">Privacy Policy</a> to see how browser storage, audio/TTS, and messages are handled.
            </li>
          </ul>
        </div>

        <div class="card">
          <h2>Helpful Details to Include</h2>
          <p style="font-size: 0.92rem; color: var(--muted); margin-bottom: 0;">When reporting a display, translation, audio, or speech issue, including the <strong>page URL</strong>, <strong>surah/verse reference</strong>, and <strong>browser or device</strong> helps resolve it faster.</p>
        </div>
      </aside>
    </div>
  </main>

  <footer>
    <div>&copy; <span id="yr">2026</span> Quran Meaning (<a href="https://quranmeaning.app">quranmeaning.app</a>). All rights reserved.</div>
    <div>
      <a href="privacy-policy.html">Privacy Policy</a> &middot; <a href="contact-us.html">Contact Us</a>
    </div>
  </footer>

  <script>
    document.getElementById("yr").textContent = String(Math.max(2026, new Date().getFullYear()));

    const form = document.getElementById("contactForm");
    const statusBox = document.getElementById("statusBox");
    const copyEmailBtn = document.getElementById("copyEmailBtn");
    const copySummaryBtn = document.getElementById("copySummaryBtn");

    function showStatus(text) {
      statusBox.textContent = text;
      statusBox.classList.add("show");
    }

    function buildFormattedMessage() {
      const name = document.getElementById("name").value.trim();
      const email = document.getElementById("email").value.trim();
      const topic = document.getElementById("topic").value;
      const message = document.getElementById("message").value.trim();
      return [
        "Website: https://quranmeaning.app",
        "Topic: " + topic,
        "Name: " + name,
        "Email: " + email,
        "",
        message
      ].join("\n");
    }

    copyEmailBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("appnanma@gmail.com");
        showStatus("Copied appnanma@gmail.com to clipboard.");
      } catch (e) {
        showStatus("Email address: appnanma@gmail.com");
      }
    });

    copySummaryBtn.addEventListener("click", async () => {
      const formatted = buildFormattedMessage();
      try {
        await navigator.clipboard.writeText(formatted);
        showStatus("Copied your formatted message to clipboard so you can paste it into any email client or form.");
      } catch (e) {
        showStatus("Could not copy automatically. Please copy your message manually and send to appnanma@gmail.com.");
      }
    });

    form.addEventListener("submit", (event) => {
      const action = (form.getAttribute("action") || "").trim();
      if (action.toLowerCase().startsWith("mailto:")) {
        event.preventDefault();
        const name = document.getElementById("name").value.trim();
        const email = document.getElementById("email").value.trim();
        const topic = document.getElementById("topic").value;
        const message = document.getElementById("message").value.trim();
        const subject = encodeURIComponent("[Quran Meaning] " + topic + (name ? " — " + name : ""));
        const body = encodeURIComponent(
          "Name: " + name + "\nEmail: " + email + "\nTopic: " + topic + "\nPage: https://quranmeaning.app\n\n" + message
        );
        window.location.href = "mailto:appnanma@gmail.com?subject=" + subject + "&body=" + body;
        showStatus("Opening your email client to send your message to appnanma@gmail.com...");
      }
    });
  </script>
</body>
</html>
